# OPTIONAL frontend key upgrades — the maps and the whole app work WITHOUT any
# key (that zero-signup contract is a project invariant; see AGENTS.md §11).
# Copy this file to frontend/web/.env (gitignored) and restart npm run dev /
# rebuild. Consumed in frontend/web/src/basemaps.js lines 23–24.

# MapTiler (free tier — https://cloud.maptiler.com → Account → Keys).
# Upgrades the basemap picker to MapTiler Streets / Satellite / Hybrid labels.
VITE_MAPTILER_KEY=

# Thunderforest (optional extra street style — https://www.thunderforest.com).
VITE_THUNDERFOREST_KEY=

# NOTE: there is deliberately NO Google tiles key here. The official Google
# Map Tiles API needs a billing-enabled GCP project and a session-token flow,
# and scraping mt{n}.google.com violates Google's ToS. See README
# “Using Google tiles” for the honest options. User LOCATION (the 📍 button)
# uses the browser Geolocation API and needs no key at all.
