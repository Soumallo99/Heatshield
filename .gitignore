# ---------------------------------------------------------------------------
# IMPORTANT: git accepts ONE pattern per line. A line like ".venv/ venv/ env/"
# is a single pattern containing spaces and matches nothing - which is exactly
# how the 851 MB virtualenv nearly ended up in this repo. Keep one per line.
# ---------------------------------------------------------------------------

# ---------------- python ----------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------------- node ----------------
node_modules/
frontend/web/dist/
frontend/web/.vite/
# CesiumJS runtime assets are copied from node_modules by
# frontend/web/scripts/copy-cesium-assets.mjs (npm prebuild/predev) - ~7 MB of
# third-party build output, reproducible from the pinned dependency.
frontend/web/public/cesium/

# Crawler files are rewritten on every build by frontend/web/plugins/siteMeta.js
# from VITE_SITE_URL, so a committed copy would be a second, staler source of
# truth for the domain. (The social card is NOT ignored: it is an input to the
# build, not an output — a PNG cannot be regenerated by a Vite plugin.)
frontend/web/public/robots.txt
frontend/web/public/sitemap.xml
frontend/web/public/llms.txt
*.local

# ---------------- secrets ----------------
.env
.env.*
!.env.example

# ---------------- regenerable data ----------------
data/raw/*.json
data/cache/*
!data/cache/.gitkeep
# keep the 36 kB forecast cache: it is what lets a fresh clone render a full
# dashboard on the very first run with no internet connection.
!data/cache/forecast_5d.parquet
data/processed/*.bak.csv

# ---------------- runtime output ----------------
logs/
# local snapshots from scripts/backup.py (they contain the subscriber registry)
backups/
*.log
# dry-run notification rehearsals are runtime records, not committed data
data/processed/notification_dry_run_log.csv

# ---------------- editors / os ----------------
.DS_Store
Thumbs.db
.idea/
# NB: .vscode/ is NOT ignored - launch.json and tasks.json are project assets
# (F5 runs the whole stack). Do not add it back.
