{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "HeatShield: API (FastAPI)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--reload",
        "--host", "0.0.0.0",
        "--port", "8000"
      ],
      "cwd": "${workspaceFolder}",
      "jinja": true,
      "justMyCode": false,
      "console": "integratedTerminal"
    },
    {
      "name": "HeatShield: Web (Vite)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/frontend/web",
      "console": "integratedTerminal"
    },
    {
      "name": "HeatShield: Full stack (API + Web)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/frontend/web",
      "console": "integratedTerminal",
      "preLaunchTask": "Start API (background)"
    },
    {
      "name": "Refresh forecast data",
      "type": "debugpy",
      "request": "launch",
      "module": "scripts.refresh",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Run scheduler (one cycle)",
      "type": "debugpy",
      "request": "launch",
      "module": "scripts.schedule",
      "args": ["--once"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Hindcast (30 days)",
      "type": "debugpy",
      "request": "launch",
      "module": "scripts.hindcast",
      "args": ["--days", "30"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Pytest: all tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests", "-q"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
