# =============================================================================
# HeatShield environment
#
# EVERY variable here is OPTIONAL. The project runs with no .env file at all —
# the defaults live in core/config.py. Copy this to .env only to override them.
# =============================================================================

# ---- data source -----------------------------------------------------------
# Open-Meteo is KEYLESS: no signup, no token, no key. That is deliberate — it
# means anyone (a judge, another student, a CI runner) can clone this repo and
# run the full pipeline without registering for anything. Don't swap it for a
# keyed provider casually. If you ever do, only core/weather.py should change.

# ---- map tiles (keyless by construction — nothing to set) ------------------
# The dashboard maps ship with four keyless basemaps — Esri (Dark Gray Canvas,
# Streets, World Imagery satellite) and Terrain (OpenTopoMap) — plus an
# automatic OpenStreetMap fallback if a tile CDN is unreachable. (CARTO was
# removed: its keyless raster endpoints started answering HTTP 200 with an
# "API KEY REQUIRED" watermark drawn into the tiles.) There is deliberately NO tile-key variable anywhere: a
# misconfigured key must never be able to paint the map with "API key
# required" error tiles. Want a commercial provider for your own deployment?
# Add it to frontend/web/src/basemaps.js yourself (README → "Maps are keyless").

# ---- core knobs (all optional) ---------------------------------------------
HS_TIMEZONE=Asia/Kolkata
HS_FORECAST_DAYS=5
HS_PAST_DAYS=1
HS_CACHE_TTL_MIN=30
HS_BATCH_SIZE=40
HS_WEB_BASE=https://heatshield.app

# ---- SMS dispatch: the ONLY credential in the project, and optional ---------
# Left blank, the alert engine still runs end to end — it composes every
# message and logs what it WOULD have sent. Nothing is transmitted.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=whatsapp:+14155238886
ALERT_TO_NUMBERS=whatsapp:+919999999999

# Where every attempted send is recorded (append-only CSV, one row per recipient).
# Point it somewhere writable in production so the log survives a redeploy.
HS_ALERT_LOG=data/processed/alert_log.csv

# ---- the second lock on live SMS -------------------------------------------
# Sending costs money and wakes people up, so live dispatch needs TWO things:
# complete Twilio credentials AND this flag. Either one missing and dispatch()
# raises PermissionError instead of sending. Accepted values: 1, true, yes.
# Leave empty unless you genuinely intend to message real people.
HS_ALLOW_LIVE_SEND=

# ---- API security (see README -> "Security") --------------------------------
# Bearer token for the administrative routes: the subscriber registry and the
# dispatch endpoints. Send it as `X-API-Key: <token>` or
# `Authorization: Bearer <token>`.
#
# Leave it blank and those routes answer 503 — they are DISABLED, not open. Set
# it on any deployment that is reachable from the internet:
#     HS_ADMIN_TOKEN=$(python -c "import secrets; print(secrets.token_urlsafe(32))")
# Setting a token also turns the interactive API docs off (they map every route);
# HS_ENABLE_DOCS=1 forces them back on, HS_ENABLE_DOCS=0 forces them off.
HS_ADMIN_TOKEN=

# Browser origins allowed to call the API, comma-separated. Blank is correct for
# the shipped app: the web client talks to the API same-origin through the Vite
# proxy in development, and a static host has no API at all. Add your frontend
# origin only if it genuinely lives somewhere else, e.g.
#     HS_ALLOWED_ORIGINS=https://heatshield.example
# Localhost dev ports are allowed automatically; HS_ALLOW_DEV_ORIGINS=0 stops that
# for a locked-down deployment.
HS_ALLOWED_ORIGINS=
HS_ALLOW_DEV_ORIGINS=1

# Requests per client per minute on the whole API (0 = unlimited). The limiter is
# in-process: it stops enumeration and casual hammering, not a determined flood.
# Put a real limiter in front for a public deployment (see README).
HS_RATE_LIMIT_PER_MIN=120

# Largest accepted request body, in bytes. Bodies here are small JSON documents.
HS_MAX_BODY_BYTES=262144

# Set to 1 only when the app runs behind a reverse proxy you control, so
# X-Forwarded-For can be trusted for rate-limiting. Otherwise a client could
# spoof it and get a fresh budget per request.
HS_TRUST_PROXY=

# How long a public read endpoint may be cached, in seconds. The data behind
# them changes at most once per forecast cycle, so a repeat visitor should not
# wait for pandas twice. 0 disables caching and every response is `no-store`.
HS_RESPONSE_CACHE_MAX_AGE=120

# ---- frontend build-time settings -------------------------------------------
# Set in the build environment, not read at runtime (Vite inlines them).
#
# The canonical URL, Open Graph tags, JSON-LD ids, robots.txt, sitemap.xml and
# llms.txt are all generated from this one value, so a custom domain is one
# line. Default: https://soumallo99.github.io/Heatshield/
VITE_SITE_URL=

# Optional error collector: any endpoint that accepts a JSON POST body. Unset,
# client errors stay in an on-device ring buffer readable as __HS_ERRORS__.
VITE_ERROR_REPORT_URL=
